# Local preview: stored analysis, no paid model calls.
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./data/phase1_submission.db
SYNC_DATABASE_URL=sqlite:///./data/phase1_submission.db
REDIS_URL=redis://127.0.0.1:6379/0
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash
EXECUTION_MODE=OFFLINE_FIXTURE
PAID_CALLS_ENABLED=false
SPEND_KILL_SWITCH_ACTIVE=true
LIVE_AGENT_ENABLED=false
LIVE_EVAL_ENABLED=false
EMBEDDED_WORKER_ENABLED=false
COMMENT_MODERATION_ENABLED=false
AUTH_EMAIL_DELIVERY_MODE=DEV_OUTBOX
AUTH_DEV_OUTBOX_VIEWER_ENABLED=false
ENABLE_AUDIENCE_LAB=false
ENABLE_SYNTHETIC_DEMO_CONTENT=false
ENABLE_SYNTHETIC_MAGAZINE=false
NARRATIVE_MEMORY_BACKEND=OFFLINE_FILE
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=reframe_runtime
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=reframe
CLICKHOUSE_SECURE=false
CLICKHOUSE_VERIFY=true
CLICKHOUSE_ALLOW_WRITE_ACCESS=false
CLICKHOUSE_PUBLICATION_ID=
CLICKHOUSE_QUERY_TIMEOUT_SECONDS=15
# See docs/runtime.md for ClickHouse bootstrap and optional paid Google validation.
# Production must use unique SECRET_KEY, CSRF_SECRET and AUTH_CODE_HMAC_SECRET,
# secure cookies, real email delivery and separately provisioned services.
